# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# MongoDB Connection URI (optional: falls back to local JSON persistence if omitted)
MONGODB_URI="mongodb+srv://username:password@cluster.mongodb.net/mallikarjuna_sugarcane"

# JWT Secret for Owner Authentication
JWT_SECRET="replace_with_a_strong_random_secret"

# Cloudinary Credentials (optional: falls back to local /uploads storage if omitted)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Groq API Key (server-side only: used for Whisper audio captions & Telugu/Hindi translation)
GROQ_API_KEY=""
